# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# The AI scanner (ENABLE_AI_SCAN=true) tries OpenAI, then OpenRouter, then Gemini (only those with a key).
# At least one key is required; without one every gray-zone column falls back to UNKNOWN.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
# OpenRouter model id (e.g. openai/gpt-4o-mini, openai/gpt-oss-120b)
MODEL_NAME=gpt-4o-mini
GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# Demo login (seeded into demo_users): dpo/dpo123, analyst/analyst123

# ---- Postgres source (read) vs snapshot target (write) ----
# Must be different URLs (e.g. different DB names). The SQL source is live only when
# ENABLE_PG_SNAPSHOT=true and both URLs are set; otherwise it is listed as demo_stub.
# Create the snapshot DB once: docker exec p-138-db-1 psql -U postgres -c "CREATE DATABASE snapshot_out"
# SOURCE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mydatabase
# SNAPSHOT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/snapshot_out
# ENABLE_PG_SNAPSHOT=false
# SNAPSHOT_SCHEMA=piiguard_snapshot
# PG_SCHEMA=public
# Comma-separated allowlist; empty scans every table in PG_SCHEMA
# PG_SCAN_TABLES=
# false = rule/regex scanner only; true = LangGraph agent (needs LLM key)
# ENABLE_AI_SCAN=false
# Columns scanned in parallel by the AI scan (1-32); lower it if the LLM provider rate-limits
# SCAN_CONCURRENCY=4
# DPO overrides on the review screen are saved as LLM few-shot examples (only while ENABLE_AI_SCAN=true)
# HITL_MEMORY_PATH=./data/hitl/dpo_few_shot_memory.json

# ---- Free-text NER (REDACT action: keep the text, replace each PII entity by a tag like [PHONE]) ----
# The regex tier (phone/email/CCCD/card/tax code) always runs. ENABLE_NER=true adds the transformer tier
# for names/places; it needs transformers + torch and downloads the model on first use (~400MB).
# ENABLE_NER=false
# NER_MODEL_NAME=NlpHUST/ner-vietnamese-electra-base
# Optional JSON {"PERSON_NAME": ["..."], ...} for the dictionary tier
# NER_DICTIONARY_PATH=

# ---- MongoDB source (read) + protected snapshot DB (write, same cluster) ----
# The NoSQL source is live only when ENABLE_MONGO=true and MONGO_URI is set; otherwise demo_stub.
# MONGO_SNAPSHOT_DB must differ from MONGO_DB; it is wiped and rebuilt on every build.
# Seed demo data: python data/fixtures/mongo/seed_mongo.py
# Evidence run:   python data/fixtures/mongo/compute/run_mongo_api_e2e.py
# MONGO_URI=mongodb://admin:admin@localhost:27017/?authSource=admin
# MONGO_DB=mydatabase
# MONGO_SNAPSHOT_DB=mydatabase_protected
# ENABLE_MONGO=false

# ---- User-supplied source URLs (stored encrypted) ----
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SOURCE_ENCRYPTION_KEY=
# false = reject loopback/private-network hosts in user-supplied URLs (use in production)
# ALLOW_PRIVATE_SOURCE_HOSTS=true

# ---- HMAC (join keys; keyed hash, not encryption) ----
HMAC_SECRET=dev-hmac-secret-change-me
HMAC_KEY_VERSION=v1

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log
# Antigravity conversation ID (used to filter logs for this project)
ANTIGRAVITY_CONV_ID=your-conversation-id-here

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
