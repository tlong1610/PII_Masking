# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# The AI scanner (ENABLE_AI_SCAN=true) tries OpenAI, then OpenRouter, then Gemini (only those with a key).
# At least one key is required; without one every gray-zone column falls back to UNKNOWN.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
# OpenRouter model id (e.g. openai/gpt-4o-mini, openai/gpt-oss-120b)
MODEL_NAME=gpt-4o-mini
GOOGLE_API_KEY=

# ---- Database (App metadata: users, runs, audit log) ----
# Option A: Supabase PostgreSQL (Recommended - IPv4 Session pooler, port 5432)
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Option B: Local SQLite (development fallback)
# DATABASE_URL=sqlite:///./data/app.db

# Demo login (seeded into demo_users): dpo/dpo123, analyst/analyst123

# ---- Postgres source (read) vs snapshot target (write) ----
# On Supabase: source and snapshot can point to the same cluster using different schemas (public vs piiguard_snapshot)
# or differentiate URLs via application_name query parameter to ensure read-only assertion passes.
# SOURCE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# SNAPSHOT_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?application_name=piiguard_snapshot&sslmode=require
# ENABLE_PG_SNAPSHOT=true
# SNAPSHOT_SCHEMA=piiguard_snapshot
# PG_SCHEMA=public
# Comma-separated allowlist; empty scans every table in PG_SCHEMA
# PG_SCAN_TABLES=
# false = rule/regex scanner only; true = LangGraph agent (needs LLM key)
# ENABLE_AI_SCAN=false
# Columns scanned in parallel by the AI scan (1-32); lower it if the LLM provider rate-limits
# SCAN_CONCURRENCY=4
# DPO overrides on the review screen are saved as LLM few-shot examples (only while ENABLE_AI_SCAN=true)
# HITL_MEMORY_PATH=./data/hitl/dpo_few_shot_memory.json

# ---- Free-text NER (REDACT action: keep the text, replace each PII entity by a tag like [PHONE]) ----
# The regex tier (phone/email/CCCD/card/tax code) always runs. ENABLE_NER=true adds the GLiNER zero-shot tier
# (names, places, addresses, bank accounts...); it needs `pip install gliner` and downloads the model on first use.
# ENABLE_NER=false
# NER_MODEL_NAME=urchade/gliner_multi_pii-v1
# Optional JSON {"PERSON_NAME": ["..."], ...} for the dictionary tier
# NER_DICTIONARY_PATH=

# ---- MongoDB source (read) + protected snapshot DB (write) ----
# MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGO_DB=mydatabase
# MONGO_SNAPSHOT_DB=mydatabase_protected
# ENABLE_MONGO=true

# ---- User-supplied source URLs (stored encrypted) ----
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SOURCE_ENCRYPTION_KEY=
# false = reject loopback/private-network hosts in user-supplied URLs (use in production)
# ALLOW_PRIVATE_SOURCE_HOSTS=true

# ---- HMAC (join keys; keyed hash, not encryption) ----
HMAC_SECRET=dev-hmac-secret-change-me
HMAC_KEY_VERSION=v1

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log
# Antigravity conversation ID (used to filter logs for this project)
ANTIGRAVITY_CONV_ID=your-conversation-id-here

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
