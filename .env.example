# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# Demo login (seeded into demo_users): dpo/dpo123, analyst/analyst123

# ---- Postgres source (read) vs snapshot target (write) ----
# Must be different URLs (e.g. different DB names). Leave empty for stub build in API tests.
# SOURCE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mydatabase
# SNAPSHOT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/piiguard_snapshot_db
# ENABLE_PG_SNAPSHOT=false
# SNAPSHOT_SCHEMA=piiguard_snapshot
# ENABLE_AI_SCAN=false

# ---- HMAC (join keys; keyed hash, not encryption) ----
HMAC_SECRET=dev-hmac-secret-change-me
HMAC_KEY_VERSION=v1

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log
# Antigravity conversation ID (used to filter logs for this project)
ANTIGRAVITY_CONV_ID=your-conversation-id-here

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
